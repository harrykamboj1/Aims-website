# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Resend Email Configuration
# Sign up at https://resend.com/
# 1. Create an API key at https://resend.com/api-keys
# 2. Verify your domain (or use onboarding@resend.dev for testing)
# 3. Set RESEND_FROM_EMAIL to your verified sender address
# 4. Set RESEND_TO_EMAIL to where contact form submissions should be delivered
# Replies are routed to the submitter via replyTo.
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=AIMS <onboarding@resend.dev>
RESEND_TO_EMAIL=your-team@example.com